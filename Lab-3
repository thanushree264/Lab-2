import java.util.*;

abstract class Vehicle {
    String vehicleNumber;
    String brand;

    Vehicle(String vehicleNumber, String brand) {
        this.vehicleNumber = vehicleNumber;
        this.brand = brand;
    }

    abstract void startEngine();

    final void showVehicleIdentity() {
        if (vehicleNumber == null || vehicleNumber.isEmpty()) {
            System.out.println("Invalid Vehicle Number");
        } else if (brand == null || brand.isEmpty()) {
            System.out.println("Invalid Brand Name");
        } else {
            System.out.println("Vehicle Number: " + vehicleNumber);
            System.out.println("Brand: " + brand);
        }
    }
}

class Car extends Vehicle {
    Car(String vehicleNumber, String brand) {
        super(vehicleNumber, brand);
    }

    @Override
    void startEngine() {
        System.out.println("Car engine is starting...");
    }
}

class Bike extends Vehicle {
    Bike(String vehicleNumber, String brand) {
        super(vehicleNumber, brand);
    }

    @Override
    void startEngine() {
        System.out.println("Bike engine is starting...");
    }
}

public class Main {
    public static void main(String[] args) {

        System.out.println("TEST CASE 1");
        Car car1 = new Car("KA01AB1234", "Toyota");
        car1.showVehicleIdentity();

        System.out.println();
        System.out.println("TEST CASE 2");
        Bike bike1 = new Bike("KA05XY5678", "Honda");
        bike1.showVehicleIdentity();

        System.out.println();
        System.out.println("TEST CASE 3");
        car1.startEngine();
        bike1.startEngine();

        System.out.println();
        System.out.println("TEST CASE 4");
        car1.showVehicleIdentity();
        bike1.showVehicleIdentity();

        System.out.println();
        System.out.println("TEST CASE 5");
        Vehicle vehicle = new Car("KA09CD9876", "Hyundai");
        vehicle.showVehicleIdentity();

        System.out.println();
        System.out.println("TEST CASE 9");
        Vehicle invalidVehicle = new Car("", "Toyota");
        invalidVehicle.showVehicleIdentity();

        System.out.println();
        System.out.println("TEST CASE 10");
        Vehicle invalidBrand = new Car("KA01AB1234", "");
        invalidBrand.showVehicleIdentity();
    }
}
